---
import '../styles/global.css';

interface Crumb { name: string; href: string }

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  breadcrumbs?: Crumb[]; // excluding Home, which is added automatically
  about?: Record<string, unknown>; // schema.org node describing what the page is about
  schema?: Record<string, unknown>[]; // extra schema.org nodes (BlogPosting, Legislation, ...)
}

const { title, description, noindex = false, ogType = 'website', breadcrumbs, about, schema = [] } = Astro.props;
const siteName = 'CommunitySolarPA';
const site = 'https://communitysolarpa.org';
// Keep titles to about 60 characters so search results don't cut them off:
// add the site name only when it fits.
const withSite = `${title} | ${siteName}`;
const fullTitle = title === siteName || withSite.length > 60 ? title : withSite;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = `${site}/og-image.png`;

// Sitewide structured data: who publishes the site, the site itself, and this page.
const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': `${site}/#org`,
    name: siteName,
    url: `${site}/`,
    logo: { '@type': 'ImageObject', url: `${site}/logo.png`, width: 512, height: 512 },
    email: 'hello@communitysolarpa.org',
    description: 'A Pennsylvania community solar information project.',
    sameAs: ['https://www.reddit.com/r/communitysolarpa/'],
  },
  {
    '@type': 'WebSite',
    '@id': `${site}/#website`,
    name: siteName,
    alternateName: 'CommunitySolarPA.org',
    url: `${site}/`,
    inLanguage: 'en-US',
    publisher: { '@id': `${site}/#org` },
  },
];
if (!noindex) {
  graph.push({
    '@type': 'WebPage',
    '@id': `${canonical.href}#webpage`,
    url: canonical.href,
    name: fullTitle,
    description,
    inLanguage: 'en-US',
    isPartOf: { '@id': `${site}/#website` },
    primaryImageOfPage: { '@type': 'ImageObject', url: ogImage },
    ...(about ? { about } : {}),
    ...(breadcrumbs ? { breadcrumb: { '@id': `${canonical.href}#breadcrumb` } } : {}),
  });
}
if (breadcrumbs && !noindex) {
  const items = [{ name: 'Home', href: '/' }, ...breadcrumbs];
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonical.href}#breadcrumb`,
    itemListElement: items.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: new URL(c.href.endsWith('/') ? c.href : `${c.href}/`, site).href,
    })),
  });
}
graph.push(...schema);
const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const nav = [
  { href: '/what-is-community-solar', label: 'How it works' },
  { href: '/why-community-solar', label: 'Why community solar' },
  { href: '/zip-lookup', label: 'Check your ZIP' },
  { href: '/pennsylvania', label: 'Pennsylvania status' },
  { href: '/about', label: 'About' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-P38KBRZH');</script>
    <!-- End Google Tag Manager -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="CommunitySolarPA: solar power for every Pennsylvanian" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="apple-touch-icon" href="/logo.png" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-P38KBRZH" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/"><img src="/favicon.svg" alt="" />CommunitySolarPA</a>
        <nav class="nav" aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
          <a class="cta" href="/#notify">Get notified</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div>© {new Date().getFullYear()} CommunitySolarPA.org · A Pennsylvania community solar information project</div>
        <div><a href="/why-community-solar">Why community solar</a> · <a href="/counties">Counties</a> · <a href="/utilities">Utility guides</a> · <a href="/zip-lookup">ZIP lookup</a> · <a href="https://www.reddit.com/r/communitysolarpa/" rel="noopener">r/communitysolarpa on Reddit</a> · <a href="/privacy">Privacy</a> · <a href="mailto:hello@communitysolarpa.org">hello@communitysolarpa.org</a></div>
      </div>
    </footer>
  </body>
</html>
