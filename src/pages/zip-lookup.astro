---
import Base from '../layouts/Base.astro';
import Signup from '../components/Signup.astro';
import { utilities, smallUtilities, ptcAsOf } from '../data/utilities';

const utilData = Object.fromEntries([
  ...utilities.map((u) => [u.code, { name: u.name, url: `/utilities/${u.slug}`, ptc: u.ptc }]),
  ...smallUtilities.map((s) => [s.code, { name: s.name, url: '/utilities#other', ptc: null }]),
]);
---
<Base
  title="Community solar ZIP code lookup for Pennsylvania"
  description="Enter your Pennsylvania ZIP code to see your electric utility, its price to compare, and what community solar would mean for your area."
>
  <div class="hero">
    <div class="wrap">
      <div class="eyebrow">ZIP lookup</div>
      <h1>Community solar near you</h1>
      <p class="lede">
        Enter your ZIP code to see which utility serves your area, its current price to compare,
        and where Pennsylvania's community solar bill stands.
      </p>
      <form id="zip-form" class="zip-form" autocomplete="on">
        <label for="zip-input" class="sr">Pennsylvania ZIP code</label>
        <input id="zip-input" name="zip" type="text" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" placeholder="Enter ZIP code" autocomplete="postal-code" required />
        <button class="btn" type="submit">Look it up</button>
      </form>
      <div id="zip-result" aria-live="polite"></div>
    </div>
  </div>

  <section>
    <div class="wrap prose">
      <h2 style="margin-top:0">Why your utility matters</h2>
      <p>
        Under Pennsylvania's community solar bill (HB 504), you'd subscribe to a project that connects
        to your own electric utility, and the credits would show up on that utility's bill. So the
        first step to knowing what's possible where you live is knowing your utility.
      </p>
      <p>
        Some ZIP codes are split between two utilities. If yours is, the utility name on your
        electric bill settles it. You can also browse <a href="/utilities">all utility guides</a>.
      </p>
      <p class="updated">
        Service areas are based on the U.S. Department of Energy's electric utilities by ZIP code
        data (2022, via OpenEI). Prices to compare are as of {ptcAsOf}.
      </p>
    </div>
  </section>

  <Signup />
</Base>

<script is:inline define:vars={{ utilData }}>
  (function () {
    var form = document.getElementById('zip-form');
    var input = document.getElementById('zip-input');
    var out = document.getElementById('zip-result');
    var data = null;

    function esc(s) { return String(s).replace(/[&<>"']/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]; }); }

    function load() {
      if (data) return Promise.resolve(data);
      return fetch('/data/pa-zips.json').then(function (r) { return r.json(); }).then(function (d) { data = d; return d; });
    }

    function prefillSignup(zip) {
      var f = document.getElementById('ml-zip');
      if (f && !f.value) f.value = zip;
    }

    function render(zip, row) {
      if (!row) {
        out.innerHTML = '<div class="result card"><h2>We couldn’t find ' + esc(zip) + '</h2><p>That doesn’t look like a Pennsylvania ZIP code in our data. Double-check it, or browse <a href="/utilities">all utility guides</a>.</p></div>';
        return;
      }
      var city = row[0], county = row[1], codes = row[2] || '';
      var estimated = codes.indexOf('?') !== -1;
      var coop = codes.indexOf('o') !== -1;
      var list = codes.replace(/[?o]/g, '').split('').filter(function (c) { return utilData[c]; });
      var place = esc(city) + (county ? ', ' + esc(county) + ' County' : '');
      var html = '<div class="result card"><div class="eyebrow">' + esc(zip) + ' · ' + place + '</div>';

      if (list.length === 0) {
        html += '<h2>This area is served by a co-op or borough utility</h2><p>Pennsylvania’s community solar bill works through the state’s regulated utilities, so as written it likely wouldn’t cover co-op or borough customers. <a href="/utilities#other">Learn more</a>.</p>';
      } else {
        html += '<h2>' + (list.length === 1 ? 'Your utility is likely ' + esc(utilData[list[0]].name) : 'Your ZIP is served by ' + list.length + ' utilities') + '</h2>';
        if (list.length > 1) html += '<p>Check the utility name on your electric bill to see which one is yours.</p>';
        html += '<div class="util-list">';
        list.forEach(function (c) {
          var u = utilData[c];
          html += '<a class="util" href="' + u.url + '"><strong>' + esc(u.name) + '</strong>' +
            (u.ptc ? '<span>Price to compare ' + u.ptc.toFixed(2) + '¢/kWh</span>' : '<span>Smaller regulated utility</span>') +
            '<span class="go">See the ' + esc(u.name) + ' guide →</span></a>';
        });
        html += '</div>';
        if (coop) html += '<p class="note">Some homes in this ZIP code get power from an electric co-op or a borough utility instead.</p>';
        if (estimated) html += '<p class="note">This ZIP code is mostly P.O. boxes, so we estimated from the county. Your bill will confirm it.</p>';
      }
      html += '<div class="next"><p><strong>Community solar isn’t available in Pennsylvania yet.</strong> The bill to create it, HB 504, is <a href="/pennsylvania">pending in the State Senate</a>. Two ways to help it along:</p>' +
        '<p><a class="btn" href="#notify">Get notified for ' + esc(zip) + '</a> &nbsp; <a class="btn secondary" href="https://www.palegis.us/find-my-legislator" rel="noopener" target="_blank">Find your state senator</a></p></div>';
      html += '</div>';
      out.innerHTML = html;
      prefillSignup(zip);
    }

    function lookup(zip) {
      zip = (zip || '').replace(/\D/g, '').slice(0, 5);
      if (zip.length !== 5) {
        out.innerHTML = '<p class="err">Please enter a 5-digit ZIP code.</p>';
        return;
      }
      out.innerHTML = '<p class="muted">Looking up ' + esc(zip) + '…</p>';
      load().then(function (d) {
        render(zip, d[zip]);
        try { history.replaceState(null, '', '?zip=' + zip); } catch (e) {}
      }).catch(function () {
        out.innerHTML = '<p class="err">Something went wrong loading the lookup. Please try again.</p>';
      });
    }

    form.addEventListener('submit', function (e) { e.preventDefault(); lookup(input.value); });
    var q = new URLSearchParams(location.search).get('zip');
    if (q) { input.value = q; lookup(q); }
  })();
</script>

<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); }
  .zip-form { display: flex; gap: 10px; max-width: 460px; margin: 8px 0 20px; }
  .zip-form input { flex: 1; min-width: 0; padding: 14px 16px; font-size: 1.1rem; border: 2px solid var(--line); border-radius: 10px; font-family: inherit; background: #fff; }
  .zip-form input:focus { outline: none; border-color: var(--green-600); }
  #zip-result :global(.result) { max-width: 720px; }
  #zip-result :global(.result h2) { margin-top: 0; }
  #zip-result :global(.util-list) { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); margin: 14px 0; }
  #zip-result :global(.util) { display: flex; flex-direction: column; gap: 4px; padding: 16px; border: 2px solid var(--green-100); border-radius: 12px; text-decoration: none; color: var(--ink); background: var(--bg); }
  #zip-result :global(.util:hover) { border-color: var(--green-600); }
  #zip-result :global(.util strong) { font-family: var(--serif); font-size: 1.3rem; color: var(--green-900); }
  #zip-result :global(.util .go) { color: var(--green-600); font-weight: 600; font-size: .95rem; }
  #zip-result :global(.note) { font-size: .9rem; color: var(--muted); }
  #zip-result :global(.next) { border-top: 1px solid var(--line); margin-top: 16px; padding-top: 16px; }
  #zip-result :global(.err) { color: #a3331f; font-weight: 600; }
  #zip-result :global(.muted) { color: var(--muted); }
  @media (max-width: 520px) { .zip-form { flex-direction: column; } }
</style>
